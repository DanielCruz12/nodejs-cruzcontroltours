PORT=3002
NODE_ENV=development

# Base de datos (elige una de las dos formas)
# Opción A: partes separadas
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=cruzcontroltours
# Opción B: URL completa (tiene prioridad si existe)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cruzcontroltours

# CORS (separadas por coma)
# 3000 = front (cruzcontroltours-nextjs), 3001 = panel (panel-cruzcontroltours)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# S3 uploads (tour images/videos; bucket must allow public reads)
S3_BUCKET=
S3_REGION=us-east-1
S3_PREFIX=tours
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Auth JWT (obligatorio para login y rutas protegidas)
JWT_SECRET=cambia-este-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=12h

# Claves iniciales del seed (npm run db:seed). Cámbialas en producción.
SEED_SUPERADMIN_PASSWORD=SuperAdmin123!
SEED_ADMIN_PASSWORD=Admin123!
SEED_HOST_PASSWORD=Host123!
